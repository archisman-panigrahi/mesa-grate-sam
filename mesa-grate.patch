From f3098a3846051744720a5c83253f041a14b6bfec Mon Sep 17 00:00:00 2001
From: Sam Pavlovic <sam@sampavlovic.com>
Date: Sat, 12 Sep 2026 17:56:54 +0000
Subject: [PATCH 15/36] grate: report the actual Tegra model as the renderer
 name

GL_RENDERER said just "Tegra", which tells you nothing about which chip you
are on and leaves anything that reports the GPU - glxinfo, screenfetch,
weston's log - equally vague. Read the chip id the kernel fused out of
/sys/devices/soc0/soc_id and report "Tegra 3 (GR3D)" and friends.
---
 src/gallium/drivers/grate/grate_screen.c | 33 +++++++++++++++++++++++-
 src/gallium/drivers/grate/grate_screen.h |  2 ++
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/grate/grate_screen.c b/src/gallium/drivers/grate/grate_screen.c
index d237272..a51853c 100755
--- a/src/gallium/drivers/grate/grate_screen.c
+++ b/src/gallium/drivers/grate/grate_screen.c
@@ -42,11 +42,40 @@ grate_screen_destroy(struct pipe_screen *pscreen)
    FREE(screen);
 }
 
+/*
+ * The GR3D block is the same programming model across Tegra generations but
+ * the marketing name is what everyone recognises, so report that. soc_id is
+ * the chip id the kernel read out of the fuses: 0x20 is Tegra 2, 0x30 Tegra 3,
+ * 0x35 Tegra 4. Anything we do not recognise just stays "Tegra".
+ */
+static void
+grate_screen_init_name(struct grate_screen *screen)
+{
+   unsigned soc_id = 0;
+   const char *model = NULL;
+   FILE *f = fopen("/sys/devices/soc0/soc_id", "r");
+
+   if (f) {
+      if (fscanf(f, "%u", &soc_id) != 1)
+         soc_id = 0;
+      fclose(f);
+   }
+
+   switch (soc_id) {
+   case 0x20: model = " 2";  break;
+   case 0x30: model = " 3";  break;
+   case 0x35: model = " 4";  break;
+   default:   model = "";    break;
+   }
+
+   snprintf(screen->name, sizeof(screen->name), "Tegra%s (GR3D)", model);
+}
+
 static const char *
 grate_screen_get_name(struct pipe_screen *pscreen)
 {
    grate_trace();
-   return "Tegra";
+   return grate_screen(pscreen)->name;
 }
 
 static const char *
@@ -506,6 +535,8 @@ grate_screen_create(int fd)
       return NULL;
    }
 
+   grate_screen_init_name(screen);
+
    screen->base.destroy = grate_screen_destroy;
    screen->base.get_name = grate_screen_get_name;
    screen->base.get_vendor = grate_screen_get_vendor;
diff --git a/src/gallium/drivers/grate/grate_screen.h b/src/gallium/drivers/grate/grate_screen.h
index 5571af1..abe0ec7 100644
--- a/src/gallium/drivers/grate/grate_screen.h
+++ b/src/gallium/drivers/grate/grate_screen.h
@@ -19,6 +19,8 @@ struct grate_screen {
 
    int fd;
    struct grate_device *drm;
+
+   char name[32];
 };
 
 static inline struct grate_screen *
-- 
