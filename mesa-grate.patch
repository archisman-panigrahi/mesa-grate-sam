+    printf "%-12s %-16s %-16s %s (max delta %d)\n", name, got, r, res, worst
+    if (ok) pass++; else fail++
+  }
+  END { printf "---- %d passed, %d failed (tolerance +/-%d) ----\n", pass, fail, tol }
+' /tmp/fp_ref.txt /tmp/fp_grate.txt
