From 66b066eb55594d977f9b970a2b89b54e903d369c Mon Sep 17 00:00:00 2001
From: Sam Pavlovic <sam@sampavlovic.com>
Date: Sat, 12 Sep 2026 20:41:22 +0000
Subject: [PATCH 19/36] grate: add the Alpine packaging recipe

Alpine's own main/mesa APKBUILD with the grate patch added to source and the
gallium driver list cut down to grate, llvmpipe and softpipe, plus a README
covering how to build it, what not to enable alongside grate, and what still
does not work.
---
 src/gallium/drivers/grate/packaging/APKBUILD  | 359 ++++++++++++++++++
 src/gallium/drivers/grate/packaging/README.md |  61 +++
 2 files changed, 420 insertions(+)
 create mode 100644 src/gallium/drivers/grate/packaging/APKBUILD
 create mode 100644 src/gallium/drivers/grate/packaging/README.md

diff --git a/src/gallium/drivers/grate/packaging/APKBUILD b/src/gallium/drivers/grate/packaging/APKBUILD
new file mode 100644
index 0000000..c2f6d09
--- /dev/null
+++ b/src/gallium/drivers/grate/packaging/APKBUILD
@@ -0,0 +1,359 @@
+# Contributor: David Heidelberg <david@ixit.cz>
+maintainer="team/alpine-desktop <achill@achill.org>"
+pkgname=mesa
+pkgver=26.2.2
+pkgrel=100
+pkgdesc="Mesa DRI OpenGL library (with the grate driver for Tegra20/30/114)"
+url="https://www.mesa3d.org"
+arch="all"
+license="MIT AND SGI-B-2.0 AND BSL-1.0"
+subpackages="
+	$pkgname-dbg
+	$pkgname-dev
+	$pkgname-dri-gallium:_gallium
+	$pkgname-egl
+	$pkgname-gl
+	$pkgname-gles
+	$pkgname-gbm
+	$pkgname-vulkan-swrast:_vulkan
+	$pkgname-vulkan-layers:_vulkan_layers
+	"
+_llvmver=23
+depends_dev="
+	libdrm-dev
+	libxdamage-dev
+	libxshmfence-dev
+	"
+makedepends="
+	$depends_dev
+	binutils
+	bison
+	cbindgen
+	elfutils-dev
+	eudev-dev
+	expat-dev
+	findutils
+	flex
+	gettext
+	glslang-dev
+	libdisplay-info-dev
+	libtool
+	libva-dev
+	libx11-dev
+	libxfixes-dev
+	libxml2-dev
+	libxrandr-dev
+	libxxf86vm-dev
+	llvm$_llvmver-dev
+	meson
+	py3-cparser
+	py3-mako
+	py3-packaging
+	py3-ply
+	py3-yaml
+	python3
+	vulkan-loader-dev
+	wayland-dev
+	wayland-protocols
+	xorgproto
+	zlib-dev
+	zstd-dev
+	"
+_paste_version="1.0.14"
+_proc_macro2_version="1.0.86"
+_quote_version="1.0.33"
+_syn_version="2.0.68"
+_unicode_ident_version="1.0.12"
+_rustc_hash_version="2.1.1"
+source="https://mesa.freedesktop.org/archive/mesa-${pkgver/_/-}.tar.xz
+	paste-$_paste_version.tar.gz::https://static.crates.io/crates/paste/paste-$_paste_version.crate
+	proc-macro2-$_proc_macro2_version.tar.gz::https://static.crates.io/crates/proc-macro2/proc-macro2-$_proc_macro2_version.crate
+	quote-$_quote_version.tar.gz::https://static.crates.io/crates/quote/quote-$_quote_version.crate
+	syn-$_syn_version.tar.gz::https://static.crates.io/crates/syn/syn-$_syn_version.crate
+	unicode-ident-$_unicode_ident_version.tar.gz::https://static.crates.io/crates/unicode-ident/unicode-ident-$_unicode_ident_version.crate
+	rustc-hash-$_rustc_hash_version.tar.gz::https://static.crates.io/crates/rustc-hash/rustc-hash-$_rustc_hash_version.crate
+	23575.patch
+	riscv64-tls.patch
+	llvm23.patch
+	0100-gallium-add-grate-driver-for-tegra20-30.patch
+	"
+builddir="$srcdir/mesa-${pkgver/_/-}"
+options="!check" # TODO
+
+_dri_driverdir=/usr/lib/dri
+# Targeted at Tegra: grate drives the Tegra20/30/114 GR3D directly, llvmpipe
+# and softpipe are the software fallbacks. The stock Alpine armv7 set also
+# builds radeonsi, nouveau, zink and the other ARM drivers; none of them are
+# any use on a Tegra and together they are hours of build time on one. Add
+# them back to this one line if you want the full set.
+_gallium_drivers="grate,llvmpipe,softpipe"
+_vulkan_drivers="swrast"
+_vulkan_layers="device-select,overlay"
+
+
+_intel_rt=disabled
+case "$CARCH" in
+	x86_64) _intel_rt=enabled ;;
+esac
+
+case "$CARCH" in
+x86)
+	# lto fails on x86 only
+	# mostly:
+	# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/21371
+	# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/21180
+	_lto=false
+	;;
+*)
+	# ~5% smaller
+	# disable temporarily until resolved:
+	# https://gitlab.freedesktop.org/mesa/mesa/-/issues/11846
+	_lto=false
+	;;
+esac
+
+_rusticl=false
+
+prepare() {
+	default_prepare
+
+	cd subprojects/
+
+	rm -f paste-1-rs.wrap proc-macro2-1-rs.wrap quote-1-rs.wrap syn-2-rs.wrap unicode-ident-1-rs.wrap rustc-hash-2-rs.wrap
+
+	mv "$srcdir/paste-$_paste_version" paste-1-rs
+	mv "$srcdir/proc-macro2-$_proc_macro2_version" proc-macro2-1-rs
+	mv "$srcdir/quote-$_quote_version" quote-1-rs
+	mv "$srcdir/syn-$_syn_version" syn-2-rs
+	mv "$srcdir/unicode-ident-$_unicode_ident_version" unicode-ident-1-rs
+	mv "$srcdir/rustc-hash-$_rustc_hash_version" rustc-hash-2-rs
+
+	cp packagefiles/paste-1-rs/meson.build paste-1-rs/
+	cp packagefiles/proc-macro2-1-rs/meson.build proc-macro2-1-rs/
+	cp packagefiles/quote-1-rs/meson.build quote-1-rs/
+	cp packagefiles/syn-2-rs/meson.build syn-2-rs/
+	cp packagefiles/unicode-ident-1-rs/meson.build unicode-ident-1-rs/
+	cp packagefiles/rustc-hash-2-rs/meson.build rustc-hash-2-rs/
+}
+
+build() {
+	# use -g1 to generate less debug info:
+	# 485 MiB -> ~80 MiB
+	export CFLAGS="$CFLAGS -O2 -g1"
+	export CXXFLAGS="$CXXFLAGS -O2 -g1"
+	export CPPFLAGS="$CPPFLAGS -O2 -g1"
+
+	case "$CARCH" in
+	armhf|armv7)
+		# gnu2 tlsdesc is broken in binutils, see
+		# https://gitlab.alpinelinux.org/alpine/aports/-/issues/14140
+		# and
+		# https://gitlab.freedesktop.org/mesa/mesa/-/issues/13236
+		export CFLAGS="$CFLAGS -mtls-dialect=gnu"
+		export CXXFLAGS="$CXXFLAGS -mtls-dialect=gnu"
+		;;
+	esac
+
+	PATH="$PATH:/usr/lib/llvm$_llvmver/bin" \
+	abuild-meson \
+		-Db_ndebug=true \
+		-Db_lto=$_lto \
+		-Dallow-kcmp=enabled \
+		-Dexpat=enabled \
+		-Dintel-rt=$_intel_rt \
+		-Dshader-cache=enabled \
+		-Dxlib-lease=enabled \
+		-Dxmlconfig=enabled \
+		-Dzstd=enabled \
+		-Dbackend_max_links=2 \
+		-Dbuild-tests="$(want_check && echo true || echo false)" \
+		-Ddri-drivers-path=$_dri_driverdir \
+		-Dgallium-drivers=$_gallium_drivers \
+		-Dvulkan-drivers=$_vulkan_drivers \
+		-Dvulkan-layers=$_vulkan_layers \
+		-Damdgpu-virtio=true \
+		-Dfreedreno-kmds=msm,virtio \
+		-Dplatforms=x11,wayland \
+		-Dllvm=enabled \
+		-Dshared-llvm=enabled \
+		-Dgbm=enabled \
+		-Dglx=dri \
+		-Dopengl=true \
+		-Dgles1=enabled \
+		-Dgles2=enabled \
+		-Degl=enabled \
+		-Dgallium-extra-hud=true \
+		-Dgallium-rusticl=$_rusticl \
+		-Dgallium-rusticl-enable-drivers=auto,freedreno \
+		-Dgallium-va=disabled \
+		-Drust_std=2021 \
+		-Dvideo-codecs=all \
+		. output
+
+	# Print config
+	meson configure --no-pager output
+
+	meson compile -C output
+}
+
+# Tests workarounds
+case "$CARCH" in
+armhf|armv7|riscv64|loongarch64|ppc64le)
+	# https://gitlab.alpinelinux.org/alpine/aports/-/issues/16525
+	_tests_opts="$_tests_opts --no-suite mesa:llvmpipe"
+	;;
+s390x|ppc64)
+	# https://gitlab.freedesktop.org/mesa/mesa/-/issues/9507
+	# mesa:amd / ac_surface_modifier_test timeouts (CI perf issue I assume)
+	_tests_opts="$_tests_opts --no-suite mesa:gallium --no-suite mesa:llvmpipe --no-suite mesa:amd"
+	;;
+esac
+
+check() {
+	LC_ALL=C.UTF=8 meson test --print-errorlogs $_tests_opts -C output
+}
+
+package() {
+	DESTDIR="$pkgdir" meson install --no-rebuild -C output
+}
+
+egl() {
+	pkgdesc="Mesa libEGL runtime libraries"
+	# gles is not directly needed but GTK+mesa throws errors when egl
+	# is installed without gles
+	# https://gitlab.alpinelinux.org/alpine/aports/-/issues/15510#note_531887
+	depends="mesa=$pkgver-r$pkgrel mesa-gles=$pkgver-r$pkgrel"
+
+	amove usr/lib/libEGL.so*
+}
+
+gl() {
+	pkgdesc="Mesa libGL runtime libraries"
+	depends="mesa=$pkgver-r$pkgrel"
+
+	amove usr/lib/libGL.so*
+}
+
+gles() {
+	pkgdesc="Mesa libGLESv2 runtime libraries"
+	depends="mesa=$pkgver-r$pkgrel"
+
+	amove usr/lib/libGLES*.so*
+}
+
+gbm() {
+	pkgdesc="Mesa gbm library"
+	depends="mesa=$pkgver-r$pkgrel"
+
+	amove usr/lib/libgbm.so.*
+}
+
+rusticl() {
+	pkgdesc="Mesa OpenCL driver"
+	depends="mesa=$pkgver-r$pkgrel clang$_llvmver-headers libclc~$_llvmver"
+
+	amove usr/lib/libRusticlOpenCL.so.*
+	amove etc/OpenCL/vendors/
+}
+
+# Move links referencing the same file to the subpackage.
+# Usage: _mv_links <base directory> <example>
+# where <example> is one of the libraries covered by the megadriver.
+# The example is used to find other links that point to the same file.
+_mv_links() {
+	install -d "$subpkgdir"/$1
+	find -L "$pkgdir"/$1 -samefile "$pkgdir"/$1/$2 -print0 \
+		| xargs -0 -I{} mv {} "$subpkgdir"/$1/
+}
+
+_mv_vulkan() {
+	local i
+	for i in "$@"; do
+		amove usr/lib/libvulkan_$i*.so
+		amove usr/share/vulkan/icd.d/${i}_*.*
+	done
+}
+
+# Mesa uses "megadrivers" where multiple drivers are linked into one shared
+# library. This library is then hard-linked to separate files (one for each driver).
+# Each subpackage contains one megadriver so that all the hard-links are preserved.
+
+_gallium() {
+	pkgdesc="Mesa gallium DRI drivers"
+	depends="mesa=$pkgver-r$pkgrel"
+
+	# libgallium_dri.so
+	_mv_links $_dri_driverdir swrast_dri.so
+}
+
+_va() {
+	local n=${subpkgname##*-va-}
+	pkgdesc="Mesa $n VAAPI drivers"
+	depends="mesa=$pkgver-r$pkgrel libva"
