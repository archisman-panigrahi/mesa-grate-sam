+++ b/src/gallium/drivers/grate/grate_compiler.h
@@ -50,6 +50,11 @@ struct grate_fp_shader {
     * general register; -1 when the shader has none */
    int tex_temp;
 
+   /* set when the shader used something the translator cannot express, so the
