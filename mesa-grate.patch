From c87393c66f87f515643c58dfd4d6d2ba04ebefaf Mon Sep 17 00:00:00 2001
From: Sam Pavlovic <sam@sampavlovic.com>
Date: Sat, 12 Sep 2026 20:40:44 +0000
Subject: [PATCH 18/36] grate: compute the barycentric weights in every
 instruction that interpolates

The weights are consumed by the interpolators in the very instruction that
computes them, but the setup was only ever folded into the first MFU
instruction. Any shader whose second or later MFU instruction interpolated a
varying therefore read stale weights.

It hid well. In a smooth varying it is a few levels of error, which the
suite's +/-10 tolerance swallowed; it only becomes obvious when the value
feeds something with gain, like a reciprocal. tests/fptest's sfu_rcp case read
156,127 against softpipe's 156,120 before this and reads 156,120 after, and
the whole suite now passes at a tolerance of 2 rather than 10.

An MFU instruction that interpolates nothing is left alone, since that is
where the special function ops do their work and they have no weights to
compute.

Also state PSEQ_DWR_IF_STATE through its field macros rather than as a bare
0x40. Feeding it the real store count instead of 1 was measured to change
nothing, so the count stays 1 and the comment now says so.
---
 src/gallium/drivers/grate/fp/tgsi.c       | 40 ++++++++++++++++-------
 src/gallium/drivers/grate/grate_program.c |  5 +--
 2 files changed, 32 insertions(+), 13 deletions(-)

diff --git a/src/gallium/drivers/grate/fp/tgsi.c b/src/gallium/drivers/grate/fp/tgsi.c
index b2f1293..3f1aaf9 100644
--- a/src/gallium/drivers/grate/fp/tgsi.c
+++ b/src/gallium/drivers/grate/fp/tgsi.c
@@ -877,15 +877,33 @@ grate_tgsi_to_fp(struct grate_fp_shader *fp, struct tgsi_parse_context *tgsi)
       }
    }
 
-   struct fp_mfu_instr *first =
-      list_first_entry(&fp->mfu_instructions, struct fp_mfu_instr, link);
-
-   first->sfu.op = FP_SFU_OP_RCP;
-   first->sfu.reg = 4;
-   first->mul[0].dst = FP_MFU_MUL_DST_BARYCENTRIC_WEIGHT;
-   first->mul[0].src[0] = FP_MFU_MUL_SRC_SFU_RESULT;
-   first->mul[0].src[1] = FP_MFU_MUL_SRC_BARYCENTRIC_COEF_0;
-   first->mul[1].dst = FP_MFU_MUL_DST_BARYCENTRIC_WEIGHT;
-   first->mul[1].src[0] = FP_MFU_MUL_SRC_SFU_RESULT;
-   first->mul[1].src[1] = FP_MFU_MUL_SRC_BARYCENTRIC_COEF_1;
+   /*
+    * The weights are consumed by the interpolators in the very instruction
+    * that computes them, so every MFU instruction that interpolates needs its
+    * own copy of the setup, not just the first one. Giving it only to the
+    * first left every later interpolation reading stale weights: a small error
+    * in a smooth varying, and a completely wrong value in anything that feeds
+    * a texture coordinate or a special function.
+    *
+    * An MFU instruction that interpolates nothing is left alone - that is
+    * where the SFU ops do their own work, and they have no weights to compute.
+    */
+   list_for_each_entry(struct fp_mfu_instr, mfu, &fp->mfu_instructions, link) {
+      bool interpolates = false;
+      for (int i = 0; i < 4; ++i)
+         if (mfu->var[i].op != FP_VAR_OP_NOP)
+            interpolates = true;
+
+      if (!interpolates && mfu->sfu.op != FP_SFU_OP_NOP)
+         continue;
+
+      mfu->sfu.op = FP_SFU_OP_RCP;
+      mfu->sfu.reg = 4;
+      mfu->mul[0].dst = FP_MFU_MUL_DST_BARYCENTRIC_WEIGHT;
+      mfu->mul[0].src[0] = FP_MFU_MUL_SRC_SFU_RESULT;
+      mfu->mul[0].src[1] = FP_MFU_MUL_SRC_BARYCENTRIC_COEF_0;
+      mfu->mul[1].dst = FP_MFU_MUL_DST_BARYCENTRIC_WEIGHT;
+      mfu->mul[1].src[0] = FP_MFU_MUL_SRC_SFU_RESULT;
+      mfu->mul[1].src[1] = FP_MFU_MUL_SRC_BARYCENTRIC_COEF_1;
+   }
 }
diff --git a/src/gallium/drivers/grate/grate_program.c b/src/gallium/drivers/grate/grate_program.c
index 5a87b0f..723fc44 100644
--- a/src/gallium/drivers/grate/grate_program.c
+++ b/src/gallium/drivers/grate/grate_program.c
@@ -251,8 +251,9 @@ grate_create_fs_state(struct pipe_context *pcontext,
    PUSH(0x20006000 | num_fp_instrs);
 
    PUSH(host1x_opcode_incr(REG_TGR3D_PSEQ_DWR_IF_STATE, 1));
-   // TODO: document/convert these values
-   PUSH(0x00000040);
+   /* START=0, COUNT=1. Feeding num_dw_instrs in here instead was measured to
+    * change nothing, so the hardware evidently does not want the store count. */
+   PUSH(TGR3D_PSEQ_DWR_IF_STATE_START(0) | TGR3D_PSEQ_DWR_IF_STATE_COUNT(1));
 
    if (soc_id == DRM_TEGRA_SOC_T114) {
       // TODO: document/convert these values
