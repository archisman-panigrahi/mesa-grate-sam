-static struct fp_alu_src_operand
-fp_alu_src_one()
-{
-   struct fp_alu_src_operand src = {
-      .index = 31,
-      .datatype = FP_DATATYPE_FIXED10,
-      .sub_reg_select_high = 1
-   };
-   return src;
-}
