+   case MESA_PRIM_LINES:          per_prim = 2; min_verts = 2;            break;
+   case MESA_PRIM_TRIANGLES:      per_prim = 3; min_verts = 3;            break;
+   case MESA_PRIM_LINE_STRIP:     per_prim = 1; min_verts = 2; overlap = 1; break;
