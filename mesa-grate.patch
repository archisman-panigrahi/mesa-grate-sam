+#define TGR3D_GLOBAL_NV_MCCIF_FIFOCTRL_NV_MCCIF_RDCL_RDFAST__MASK	0x00000008
+#define TGR3D_GLOBAL_NV_MCCIF_FIFOCTRL_NV_MCCIF_RDCL_RDFAST__SHIFT	3
+static inline uint32_t TGR3D_GLOBAL_NV_MCCIF_FIFOCTRL_NV_MCCIF_RDCL_RDFAST(enum TGR3D_STATE_ENABLE val)
