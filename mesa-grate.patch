+
+static inline uint32_t REG_TGR3D_GLOBAL_SURFOVERADDR(uint32_t i0) { return 0x00000e30 + 0x1*i0; }
+#define REG_TGR3D_GLOBAL_SURFOVERADDR_LENGTH			16
