new file mode 100644
index 0000000..22de592
--- /dev/null
+++ b/src/gallium/drivers/grate/grate_bo.c
@@ -0,0 +1,323 @@
+/*
+ * Copyright © 2012, 2013 Thierry Reding
+ * Copyright © 2013 Erik Faye-Lund
