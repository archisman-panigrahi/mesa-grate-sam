+}
+#define TGR3D_GLOBAL_NV_MCCIF_FIFOCTRL_NV_MCCIF_WRMC_CLLE2X__MASK	0x00000004
+#define TGR3D_GLOBAL_NV_MCCIF_FIFOCTRL_NV_MCCIF_WRMC_CLLE2X__SHIFT	2
